{
  "name": "@sejta/lui",
  "version": "0.1.0",
  "private": true,
  "description": "Compact internal Vue 3 UI framework / UI kit.",
  "packageManager": "npm@10",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "COMPONENTS.md",
    "STYLES.md",
    "ROADMAP.md"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/index.ts",
    "./composables": "./src/composables/index.ts",
    "./components": "./src/components/index.ts",
    "./app": "./src/app/index.ts"
  },
  "peerDependencies": {
    "vue": "^3.4.0 || ^3.5.0"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.7.4",
    "typescript": "^5.9.0",
    "vite": "^6.4.1",
    "vue": "^3.5.30"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json"
  }
}

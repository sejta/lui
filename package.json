{
  "name": "@sejtax/lui",
  "version": "1.0.10",
  "private": false,
  "description": "Compact Vue 3 UI library for settings screens, admin panels, overlays, and small app shells.",
  "license": "MIT",
  "author": "Sejta",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "component-library",
    "design-system",
    "admin"
  ],
  "homepage": "https://github.com/sejta/lui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sejta/lui.git"
  },
  "bugs": {
    "url": "https://github.com/sejta/lui/issues"
  },
  "packageManager": "npm@10",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "COMPONENTS.md",
    "STYLES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app.js"
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4"
  },
  "peerDependencies": {
    "vue": "^3.4.0 || ^3.5.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^6.4.1",
    "vue": "^3.5.30"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && npm run build:types",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json"
  }
}
